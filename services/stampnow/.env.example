# Lokal: Datei kopieren zu .env und starten mit:  node --env-file=.env src/server.js
# In Produktion (Railway) diese Werte unter "Variables" setzen – NIE ins Git.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://stampit:stampit@localhost/stampit

# Pflicht in Produktion (min. 32 Zeichen). Erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_SECRET NIE mehr ändern, sonst werden alle Kunden-QR-Codes ungültig.
APP_SECRET=
ADMIN_TOKEN=

# Apple Wallet (Inhalt der PEM-Dateien aus deinem certs-Ordner)
APPLE_TEAM_ID=AQL23BUY65
APPLE_PASS_TYPE_ID=pass.com.janik.stampit
APPLE_SIGNER_CERT_PEM=
APPLE_SIGNER_KEY_PEM=
APPLE_WWDR_PEM=

# Google Wallet
GOOGLE_ISSUER_ID=3388000000023172086
# kompletter Inhalt von service-account.json in EINER Zeile
GOOGLE_SERVICE_ACCOUNT_JSON=

# Erscheint in den Datenschutzhinweisen (du als Auftragsverarbeiter)
PROCESSOR_NAME=
PROCESSOR_ADDRESS=
# Impressum auf der Startseite
CONTACT_EMAIL=
CONTACT_PHONE=
HOSTING_INFO=Railway Corporation (Serverstandort EU)

# Optional
# AUTOMATIONS_ENABLED=false   # Nachrichten global aus (z.B. in Staging)
# JOBS_ENABLED=false          # Hintergrundjobs aus
